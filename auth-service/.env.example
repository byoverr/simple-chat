APP_ENV=local
LOG_LEVEL=debug
GRPC_ADDR=:50051
DATABASE_URL=postgres://auth:authpass@localhost:5432/authdb?sslmode=disable

JWT_ACCESS_TTL=10m
JWT_SECRET=super-long-random-secret-at-least-64-chars

REFRESH_TTL=720h
REFRESH_PEPPER=another-long-secret-used-for-refresh-hash
REFRESH_TOKEN_BYTES=32
REFRESH_REUSE_DETECT=true

PASSWORD_HASH_ALGO=bcrypt
BCRYPT_COST=12
PASSWORD_MIN_LEN=8

METRICS_ADDR=:9090
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=auth-service