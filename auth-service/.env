# Application Settings
APP_ENV=local
LOG_LEVEL=debug

# gRPC Server
GRPC_ADDR=:50051

# Database
DATABASE_URL=postgres://auth:authpass@localhost:5432/authdb?sslmode=disable

# JWT Settings
JWT_ACCESS_TTL=15m
JWT_SECRET=supersecretkey_must_be_very_long_at_least_64_chars_for_production_use

# Refresh Token Settings
REFRESH_TTL=720h
REFRESH_PEPPER=another_long_secret_pepper_for_refresh_token_hashing_must_be_secret
REFRESH_TOKEN_BYTES=32
REFRESH_REUSE_DETECT=true

# Password Settings
PASSWORD_HASH_ALGO=bcrypt
BCRYPT_COST=12
PASSWORD_MIN_LEN=8

# Observability
METRICS_ADDR=:9090
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=auth-service

